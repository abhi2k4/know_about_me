# Environment variables example for the know_about_me project
# Copy this file to `.env` and fill in the real values before running the app.
# NOTE: Variables that start with `VITE_` are injected into the client bundle by Vite
# and are therefore visible in browser developer tools. Keep only non-sensitive
# values there. Keep sensitive keys (DB, email passwords, etc.) on the server and
# never commit them to source control.

# ------------------------
# Client / Vite (frontend)
# ------------------------
# Supabase (used client-side here with the anon key)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key-example

# Arena Admin — password gate (set to anything you want)
VITE_ARENA_KEY=your-secret-key-here

# Cloudinary — used for image uploads in the Arena admin
# Cloud name is visible in your Cloudinary dashboard
VITE_CLOUDINARY_CLOUD_NAME=ds2uw5gcw
# Create an unsigned upload preset: Cloudinary → Settings → Upload → Add upload preset
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# EmailJS (used to send emails from the frontend)
VITE_EMAILJS_SERVICE_ID=service_xxx
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_xxx
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=template_xxx
VITE_EMAILJS_PUBLIC_KEY=public_key_xxx

# ------------------------
# Server (backend)
# ------------------------
# Email account used to send notifications (Gmail recommended with an app password)
EMAIL_USER=you@example.com
# App password (Gmail app password or equivalent) - keep this secret
EMAIL_APP_PASSWORD=your-app-password

# Postgres connection string for the notification worker
# Example: postgres://username:password@host:5432/dbname
DATABASE_URL=postgres://username:password@host:5432/your_db

# Where to send contact notification emails (owner/recipient)
NOTIFICATION_EMAIL=owner@example.com

# NODE_ENV can be 'development' or 'production'
NODE_ENV=development

# ------------------------
# Notes
# ------------------------
# - For local development, copy this file to `.env` and fill in the real values.
# - For production, set these variables in your hosting provider (Vercel, Render, etc.)
# - Do NOT commit your real `.env` to git. This repository's `.gitignore` already
#   excludes `.env`.
